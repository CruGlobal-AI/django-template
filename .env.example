# Copy to .env for local dev:  cp .env.example .env
#
# On Cloud Run:
#   [secret]  = put in Secret Manager, attach with --set-secrets / module `secrets`
#   [env]     = plain env var, module `environment`
#   [cloudrun]= set by Cloud Run or the cru-terraform modules, don't set by hand
# On Coolify dev (see "Dev on Coolify" in the README):
#   [coolify] = set on the app's Environment Variables page
#   [coolify secret] = same, with the secret box ticked

# [secret] [coolify secret] Long random string, new one for Coolify. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-not-secret

# [env] [coolify] Never True on Cloud Run or Coolify. Defaults to False when unset.
DEBUG=True

# [env] [coolify] Comma separated. On Cloud Run: the *.run.app host and custom domain.
# On Coolify: django-template-dev.<your-domain>
ALLOWED_HOSTS=localhost,127.0.0.1

# [env] [coolify] Comma separated, with scheme. On Cloud Run: https://<your domain>
# On Coolify: https://django-template-dev.<your-domain>
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database. Names match the shared Cloud SQL wiring in cru-terraform.
# [env] On Cloud Run: shared instance private IP (shared_cloudsql outputs).
# [coolify] On Coolify: internal hostname of the Postgres resource.
DB_HOST=db
DB_PORT=5432
# [env] On Cloud Run: <project>_<env>, from the cloudsql/database module.
# [coolify] On Coolify: database name from the Postgres resource.
DB_NAME=app
# Local and Coolify use these (copy from the Postgres resource on Coolify, and
# mark DB_PASSWORD as [coolify secret]). On Cloud Run the app is meant to log in
# with IAM auth (DB_IAM_USER, no password). Password auth must keep working for Coolify.
DB_USER=app
DB_PASSWORD=app

# [cloudrun] Cloud Run sets PORT=8080. Not needed locally.
# PORT=8080
